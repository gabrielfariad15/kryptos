<?xml version="1.0" encoding="utf-8"?>
<!-- Nada do Kryptos sai do aparelho: nem backup na nuvem nem transferencia direta para
     outro aparelho (Android 12+). O android:allowBackup="false" do manifesto so barra a
     nuvem e o adb; a transferencia direta precisa destas regras. As chaves do Keystore
     nunca saem do aparelho, entao uma copia nao abriria; isto e a segunda barreira.
     documentacao/arquitetura/agenda-gravada.md -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
